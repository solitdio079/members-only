PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Prefer the private/internal PostgreSQL URL supplied by Coolify.
DATABASE_URL=postgresql://user:password@postgres:5432/members_only

# Generate with: openssl rand -base64 48
SECRET=replace-with-a-random-session-secret-at-least-32-characters-long

# Codes entered by users to become members or administrators.
PASSCODE=replace-with-member-passcode
ADMIN_PASSCODE=replace-with-admin-passcode
